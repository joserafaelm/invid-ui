{
  "name": "invid-ui",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "@react-native-community/datetimepicker": "9.2.1",
      "@tanstack/react-form": "^1.33.5",
      "@types/react": "~19.3.0",
      "expo": "~58.0.21",
      "lucide-react-native": "^1.57.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-native": "0.88.0",
      "react-native-gesture-handler": "~3.3.0",
      "react-native-reanimated": "4.7.1",
      "react-native-safe-area-context": "~5.10.1",
      "react-native-svg": "15.16.0",
      "react-native-worklets": "0.13.0",
      "typescript": "~6.0.3"
    }
  },
  "scripts": {
    "build": "bun run --filter @invid/ui build",
    "check": "bunx --bun @biomejs/biome check --write .",
    "clean": "bun scripts/clean.ts",
    "demo": "bun run build && bun run --cwd apps/demo start",
    "demo:android": "bun run build && bun run --cwd apps/demo android",
    "demo:ios": "bun run build && bun run --cwd apps/demo ios",
    "deps:sync": "bun scripts/update-deps.ts --sync-only",
    "deps:update": "bun scripts/update-deps.ts",
    "dev": "bun run --filter @invid/ui dev",
    "format": "bunx --bun @biomejs/biome format --write .",
    "lint": "bunx --bun @biomejs/biome lint --write .",
    "storybook": "bun run build && bun run --cwd apps/storybook start",
    "storybook:android": "bun run build && bun run --cwd apps/storybook android",
    "storybook:ios": "bun run build && bun run --cwd apps/storybook ios",
    "typecheck": "bun run build && bun run --filter '*' typecheck && tsc -p scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.4",
    "typescript": "catalog:"
  }
}
