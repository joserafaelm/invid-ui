{
  "name": "invid-ui",
  "version": "1.0.0",
  "description": "React Native UI components styled with Uniwind.",
  "type": "module",
  "sideEffects": ["./theme.css"],
  "files": ["dist", "README.md", "theme.css"],
  "exports": {
    "./p": {
      "types": "./dist/ui/p.d.ts",
      "default": "./dist/ui/p.js"
    },
    "./package.json": "./package.json",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "android": "bun run build && bun --cwd example android",
    "build": "bunx tsc -p tsconfig.build.json",
    "check": "bunx --bun @biomejs/biome check --write .",
    "format": "bunx --bun @biomejs/biome format --write .",
    "ios": "bun run build && bun --cwd example ios",
    "lint": "bunx --bun @biomejs/biome lint --write .",
    "prepack": "bun run build",
    "start": "bun run build && bun --cwd example start",
    "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p example/tsconfig.json"
  },
  "dependencies": {
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "react": ">=19.1.0 <20.0.0",
    "react-native": ">=0.82.0 <0.87.0",
    "tailwindcss": ">=4.0.0 <5.0.0",
    "uniwind": ">=1.12.0 <2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/react": "~19.2.18",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "uniwind": "^1.12.0"
  },
  "workspaces": ["example"]
}
