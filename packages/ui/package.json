{
  "name": "@invid/ui",
  "version": "1.0.0",
  "description": "React Native UI components for iOS and Android.",
  "type": "module",
  "sideEffects": ["./dist/internal/styles.js"],
  "files": ["dist", "README.md"],
  "exports": {
    "./metro": {
      "types": "./dist/metro/with-invid-ui.d.ts",
      "default": "./dist/metro/with-invid-ui.js"
    },
    "./p": {
      "types": "./dist/ui/p.d.ts",
      "default": "./dist/ui/p.js"
    },
    "./provider": {
      "types": "./dist/provider/invid-ui-provider.d.ts",
      "default": "./dist/provider/invid-ui-provider.js"
    },
    "./theme": {
      "types": "./dist/theme/use-theme-color.d.ts",
      "default": "./dist/theme/use-theme-color.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#/*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.metro.json && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.metro.json && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.metro.json"
  },
  "dependencies": {
    "heroui-native": "^1.0.10",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "peerDependencies": {
    "react": ">=19.1.0 <20.0.0",
    "react-native": ">=0.82.0 <0.87.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.1.1",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-svg": "^15.12.1",
    "react-native-worklets": ">=0.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "catalog:",
    "metro-config": "^0.84.3",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-worklets": "catalog:",
    "typescript": "catalog:"
  }
}
