{
  "name": "@invid/ui",
  "version": "1.0.0",
  "description": "React Native UI components for iOS and Android.",
  "type": "module",
  "sideEffects": ["./dist/internal/styles.js"],
  "files": ["dist", "README.md", "form.md"],
  "exports": {
    "./metro": {
      "types": "./dist/metro/with-invid-ui.d.ts",
      "default": "./dist/metro/with-invid-ui.js"
    },
    "./p": {
      "types": "./dist/ui/p.d.ts",
      "default": "./dist/ui/p.js"
    },
    "./provider": {
      "types": "./dist/provider/invid-ui-provider.d.ts",
      "default": "./dist/provider/invid-ui-provider.js"
    },
    "./theme": {
      "types": "./dist/theme/use-theme-color.d.ts",
      "default": "./dist/theme/use-theme-color.js"
    },
    "./button": {
      "types": "./dist/ui/button.d.ts",
      "default": "./dist/ui/button.js"
    },
    "./container": {
      "types": "./dist/ui/container.d.ts",
      "default": "./dist/ui/container.js"
    },
    "./text-input": {
      "types": "./dist/ui/form/text-input.d.ts",
      "default": "./dist/ui/form/text-input.js"
    },
    "./number-input": {
      "types": "./dist/ui/form/number-input.d.ts",
      "default": "./dist/ui/form/number-input.js"
    },
    "./text-area": {
      "types": "./dist/ui/form/text-area.d.ts",
      "default": "./dist/ui/form/text-area.js"
    },
    "./phone-input": {
      "types": "./dist/ui/form/phone-input.d.ts",
      "default": "./dist/ui/form/phone-input.js"
    },
    "./select": {
      "types": "./dist/ui/form/select.d.ts",
      "default": "./dist/ui/form/select.js"
    },
    "./radio-group": {
      "types": "./dist/ui/form/radio-group.d.ts",
      "default": "./dist/ui/form/radio-group.js"
    },
    "./form-field": {
      "types": "./dist/ui/form/form-field.d.ts",
      "default": "./dist/ui/form/form-field.js"
    },
    "./form-fields": {
      "types": "./dist/ui/form/form-fields.d.ts",
      "default": "./dist/ui/form/form-fields.js"
    },
    "./date-picker": {
      "types": "./dist/ui/form/date-time-picker/date-picker.d.ts",
      "default": "./dist/ui/form/date-time-picker/date-picker.js"
    },
    "./time-picker": {
      "types": "./dist/ui/form/date-time-picker/time-picker.d.ts",
      "default": "./dist/ui/form/date-time-picker/time-picker.js"
    },
    "./title": {
      "types": "./dist/ui/title.d.ts",
      "default": "./dist/ui/title.js"
    },
    "./icons": {
      "types": "./dist/ui/icon.d.ts",
      "default": "./dist/ui/icon.js"
    },
    "./avatar": {
      "types": "./dist/ui/avatar/avatar.d.ts",
      "default": "./dist/ui/avatar/avatar.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#/*": "./dist/*.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.metro.json && tsc -p tsconfig.build.json",
    "dev": "rm -rf dist && tsc -p tsconfig.metro.json && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.metro.json"
  },
  "dependencies": {
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": "^9.1.0",
    "@tanstack/react-form": "^1.33.5",
    "lucide-react-native": "^1.57.0",
    "react": ">=19.1.0 <20.0.0",
    "react-native": ">=0.82.0 <0.89.0",
    "react-native-svg": "^15.12.1"
  },
  "peerDependenciesMeta": {
    "@react-native-community/datetimepicker": {
      "optional": true
    },
    "@tanstack/react-form": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-community/datetimepicker": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@types/node": "^24.0.0",
    "@types/react": "catalog:",
    "lucide-react-native": "catalog:",
    "metro-config": "^0.84.3",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:",
    "typescript": "catalog:"
  }
}
